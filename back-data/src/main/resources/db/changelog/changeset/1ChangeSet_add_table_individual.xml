<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">
    <changeSet id="1_data" author="Ilia">
        <createTable tableName="individual" remarks="Таблица пользователей">

            <column name="uuid" type="varchar(36)" autoIncrement="false" remarks="UUID">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="icp" type="varchar(32)" remarks="Индивидуальный клиентский профиль">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="varchar(50)" remarks="Индивидуальный клиентский профиль">
                <constraints nullable="false" />
            </column>
            <column name="surname" type="varchar(50)" remarks="Индивидуальный клиентский профиль">
                <constraints nullable="false" />
            </column>
            <column name="patronymic" type="varchar(50)" remarks="Индивидуальный клиентский профиль">
                <constraints nullable="true" />
            </column>
            <column name="age" type="int" remarks="Индивидуальный клиентский профиль">
                <constraints nullable="true" />
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="individual"/>
        </rollback>
    </changeSet>
</databaseChangeLog>